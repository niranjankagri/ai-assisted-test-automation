<?xml version="1.0" encoding="UTF-8"?>
<!--
  AI-assisted test automation: Claude drafts Playwright tests from plain-language test cases,
  quality gates decide whether a draft is good enough for human review, and Claude triages
  failed runs. Everything (demo app, AI tooling, tests) is one Maven project.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.niranjankagri</groupId>
    <artifactId>ai-assisted-test-automation</artifactId>
    <version>1.0.0</version>
    <name>AI-assisted test automation (Java, Playwright, Claude)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Which TestNG suite `mvn test` runs: unit (default: app and tooling tests) or ui (browser tests) -->
        <suite>unit</suite>
        <!-- Arguments for the CLI: mvnw test-compile exec:exec@ai -Dcli="generate TC-103" -->
        <cli>help</cli>
    </properties>

    <!--
      Every Jackson module on one patched version. The Anthropic SDK brings in 2.19.4, which has
      known jackson-databind vulnerabilities (fixed in 2.21.7); the BOM lifts core, annotations,
      databind and the SDK's datatype modules together so they never mix versions.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Official Anthropic Java SDK: the only way the tooling talks to Claude -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>3.1.0</version>
        </dependency>
        <!--
          JSON for the demo app and the AI tooling, declared because this code uses it directly.
          The version comes from the Jackson BOM above.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Playwright for Java: the tests drive the browser with it, and the quality gate runs drafts with it -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
        </dependency>
        <!-- TestNG is a compile dependency (not test scope): the quality gate runs drafted tests from main code -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <!--
              Pinned to 3.5.6 on purpose: Surefire 3.6.0 auto-detects the JUnit Platform provider in
              TestNG projects and then ignores testng.xml and its listeners.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng-${suite}.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
            <!--
              The CLI (ai.cmd / ai.sh call this). exec:exec starts a separate JVM with the test classpath
              on -classpath, because the quality gate compiles drafts against java.class.path.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <!--
                      Own execution id (exec:exec@ai) so this configuration does not leak into other exec
                      calls, such as CI's `exec:java` that installs the Playwright browsers.
                    -->
                    <execution>
                        <id>ai</id>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <commandlineArgs>-classpath %classpath com.niranjankagri.aitesting.Cli ${cli}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
