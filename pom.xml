<?xml version="1.0" encoding="UTF-8"?>
<!--
  AI-assisted test automation: Claude drafts Playwright tests from plain-language test cases,
  quality gates decide whether a draft is good enough for human review, and Claude triages
  failed runs. Everything (demo app, AI tooling, tests) is one Maven project.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.niranjankagri</groupId>
    <artifactId>ai-assisted-test-automation</artifactId>
    <version>1.0.0</version>
    <name>AI-assisted test automation (Java, Playwright, Claude)</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Which TestNG suite `mvn test` runs: unit (no browser, default), ui, or all -->
        <suite>unit</suite>
    </properties>

    <dependencies>
        <!-- Official Anthropic Java SDK: the only way the tooling talks to Claude -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.73.0</version>
        </dependency>
        <!--
          JSON for the demo app and the AI tooling. Same version the Anthropic SDK brings in, declared
          because this code uses it directly.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.19.4</version>
        </dependency>
        <!-- Playwright for Java: the tests drive the browser with it, and the quality gate runs drafts with it -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.63.0</version>
        </dependency>
        <!-- TestNG is a compile dependency (not test scope): the quality gate runs drafted tests from main code -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <!--
              Pinned to 3.5.6 on purpose: Surefire 3.6.0 auto-detects the JUnit Platform provider in
              TestNG projects and then ignores testng.xml and its listeners.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/testng-${suite}.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>
            <!-- `mvn exec:java -Dexec.args="..."` runs the CLI (app, generate, approve, triage) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>com.niranjankagri.aitesting.Cli</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
